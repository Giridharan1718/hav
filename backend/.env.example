# Copy to backend/.env and fill in. Never commit real values.
# Development defaults are safe only on a loopback machine; production refuses
# to boot with development keys or the mock SMS adapter.

HVA_ENV=development
HVA_LOG_LEVEL=INFO
HVA_DATABASE_URL=postgresql+psycopg://hva:hva@127.0.0.1:55432/hva

# Frontend origin and API origin (used for CORS, redirects and cookie policy).
HVA_APP_BASE_URL=http://localhost:3000
HVA_API_BASE_URL=http://localhost:8000
HVA_CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HVA_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HVA_ENCRYPTION_KEY=

# --- provider adapters: leave unset to keep the capability visibly disabled ---
# SMS: disabled | mock | http  (mock is refused when HVA_ENV=production)
HVA_SMS_PROVIDER=mock
HVA_SMS_HTTP_URL=
HVA_SMS_HTTP_TOKEN=

# Email: disabled | outbox | smtp (outbox writes development mail to backend/.dev-outbox)
HVA_EMAIL_PROVIDER=outbox
HVA_SMTP_HOST=
HVA_SMTP_PORT=587
HVA_SMTP_USERNAME=
HVA_SMTP_PASSWORD=
HVA_SMTP_FROM=no-reply@hva.local

# Language model: disabled | openai_compatible
HVA_LLM_PROVIDER=disabled
HVA_LLM_BASE_URL=
HVA_LLM_API_KEY=
HVA_LLM_MODEL=

# Translation: catalog (curated database translations) | http
HVA_TRANSLATION_PROVIDER=catalog
HVA_TRANSLATION_HTTP_URL=
HVA_TRANSLATION_HTTP_TOKEN=

# Speech-to-text: disabled | http
HVA_TRANSCRIPTION_PROVIDER=disabled
HVA_TRANSCRIPTION_HTTP_URL=
HVA_TRANSCRIPTION_HTTP_TOKEN=

# OIDC (all four required to enable the authorization-code flow)
HVA_OIDC_ISSUER=
HVA_OIDC_CLIENT_ID=
HVA_OIDC_CLIENT_SECRET=
HVA_OIDC_REDIRECT_URI=

# Postal lookup: local (seeded sample dataset) | http (authorized provider endpoint)
HVA_POSTAL_SOURCE=local
HVA_POSTAL_HTTP_URL=
HVA_POSTAL_HTTP_TOKEN=
HVA_POSTAL_CACHE_TTL_HOURS=168

# Hosts approved for source ingestion (comma separated, https only).
HVA_APPROVED_INGEST_HOSTS=pmkisan.gov.in,pmjay.gov.in,scholarships.gov.in,socialjustice.gov.in,pmayg.dord.gov.in,nsap.dord.gov.in,nrega.nic.in,pfrda.org.in,indiapost.gov.in
